<?php
$e = static function ($value) {
    return htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
};
$records = isset($records) && is_array($records) ? $records : [];
$grouped = [];
foreach ($records as $record) {
    $record = is_object($record) ? (array)$record : (array)$record;
    $type = '';
    foreach (['type', 'record-type', 'record_type', 'recordType', 'dns-type', 'dns_type'] as $key) {
        if (isset($record[$key]) && is_scalar($record[$key])) {
            $type = strtoupper(trim((string)$record[$key]));
            break;
        }
    }
    if ($type === '') {
        $type = $this->_('LogicboxesEmail.dns.other', true);
    }
    $grouped[$type][] = $record;
}
ksort($grouped);

$nameservers = [
    'ns1.kanumhost.com',
    'ns2.kanumhost.com',
    'ns3.kanumhost.com',
    'ns4.kanumhost.com'
];
?>
<div class="logicboxes-email-dns-setup">
    <style>
        .logicboxes-email-dns-setup .dns-page-heading { margin-bottom: 20px; }
        .logicboxes-email-dns-setup .dns-page-heading h3 { margin-top: 0; margin-bottom: 8px; }
        .logicboxes-email-dns-setup .dns-panel { background: #fff; border: 1px solid #e3e7ed; border-radius: 9px; margin: 0 0 18px; overflow: hidden; }
        .logicboxes-email-dns-setup .dns-panel-heading { padding: 14px 18px; background: #f8fafc; border-bottom: 1px solid #e9edf2; }
        .logicboxes-email-dns-setup .dns-panel-heading h4 { margin: 0; font-size: 16px; font-weight: 600; }
        .logicboxes-email-dns-setup .dns-panel-body { padding: 18px; }
        .logicboxes-email-dns-setup .dns-nameserver-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(215px, 1fr)); gap: 10px; margin: 14px 0; }
        .logicboxes-email-dns-setup .dns-copy-line { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-width: 0; padding: 11px 12px; border: 1px solid #e6eaf0; border-radius: 7px; background: #fff; }
        .logicboxes-email-dns-setup .dns-copy-line code { overflow-wrap: anywhere; font-size: 13px; }
        .logicboxes-email-dns-setup .dns-copy-button { flex: 0 0 auto; }
        .logicboxes-email-dns-setup .dns-copy-status { display: inline-block; margin-left: 8px; font-size: 12px; }
        .logicboxes-email-dns-setup .dns-record-group { border: 1px solid #e3e7ed; border-radius: 8px; margin: 12px 0; overflow: hidden; }
        .logicboxes-email-dns-setup .dns-record-group > summary { cursor: pointer; list-style: none; padding: 13px 15px; background: #f8fafc; font-weight: 600; }
        .logicboxes-email-dns-setup .dns-record-group > summary::-webkit-details-marker { display: none; }
        .logicboxes-email-dns-setup .dns-record-group > summary:after { content: '+'; float: right; color: #667085; font-size: 18px; line-height: 16px; }
        .logicboxes-email-dns-setup .dns-record-group[open] > summary:after { content: '−'; }
        .logicboxes-email-dns-setup .dns-record-count { float: right; margin-right: 12px; color: #667085; font-size: 12px; font-weight: 400; }
        .logicboxes-email-dns-setup .dns-record-table { margin: 0; }
        .logicboxes-email-dns-setup .dns-record-table th { width: 25%; }
        .logicboxes-email-dns-setup .dns-record-table td { vertical-align: middle !important; overflow-wrap: anywhere; }
        .logicboxes-email-dns-setup .dns-record-table td code { white-space: pre-wrap; overflow-wrap: anywhere; }
        .logicboxes-email-dns-setup .dns-record-table .dns-value-cell { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
        .logicboxes-email-dns-setup .dns-record-table .dns-value-cell code { min-width: 0; }
        .logicboxes-email-dns-setup .dns-help-note { margin-top: 16px; margin-bottom: 0; }
        @media (max-width: 600px) {
            .logicboxes-email-dns-setup .dns-panel-body { padding: 12px; }
            .logicboxes-email-dns-setup .dns-record-table th { width: auto; }
            .logicboxes-email-dns-setup .dns-record-table .dns-value-cell { align-items: flex-start; flex-direction: column; gap: 7px; }
            .logicboxes-email-dns-setup .dns-record-count { float: none; display: block; margin: 3px 0 0; }
        }
    </style>

    <div class="dns-page-heading">
        <h3><?= $e(sprintf($this->_('LogicboxesEmail.dns.title', true), $domain ?? '')) ?></h3>
        <p><?= $e($this->_('LogicboxesEmail.dns.description', true)) ?></p>
    </div>

    <?php if (!empty($error)): ?>
        <div class="alert alert-warning"><?= $e($error) ?></div>
    <?php endif; ?>

    <section class="dns-panel">
        <div class="dns-panel-heading">
            <h4><?= $e($this->_('LogicboxesEmail.dns.nameservers_title', true)) ?></h4>
        </div>
        <div class="dns-panel-body">
            <p><?= $e($this->_('LogicboxesEmail.dns.nameservers_intro', true)) ?></p>
            <div class="dns-nameserver-grid">
                <?php foreach ($nameservers as $nameserver): ?>
                    <div class="dns-copy-line">
                        <code><?= $e($nameserver) ?></code>
                        <button type="button" class="btn btn-default btn-sm dns-copy-button" data-copy="<?= $e($nameserver) ?>">Copiar</button>
                    </div>
                <?php endforeach; ?>
            </div>
            <p>
                <button type="button" class="btn btn-primary btn-sm dns-copy-button" data-copy="<?= $e(implode("\n", $nameservers)) ?>">Copiar os 4 nameservers</button>
                <span class="dns-copy-status" aria-live="polite"></span>
            </p>
            <p class="text-muted"><?= $e($this->_('LogicboxesEmail.dns.nameservers_instructions', true)) ?></p>
        </div>
    </section>

    <section class="dns-panel">
        <div class="dns-panel-heading">
            <h4><?= $e($this->_('LogicboxesEmail.dns.records_title', true)) ?></h4>
        </div>
        <div class="dns-panel-body">
            <p><?= $e(sprintf($this->_('LogicboxesEmail.dns.records_instructions', true), $domain ?? '')) ?></p>

            <?php if (!$records): ?>
                <div class="alert alert-info"><?= $e($this->_('LogicboxesEmail.dns.no_records', true)) ?></div>
            <?php else: ?>
                <?php foreach ($grouped as $type => $items): ?>
                    <details class="dns-record-group" open>
                        <summary>
                            <?= $e($type) ?>
                            <span class="dns-record-count"><?= count($items) ?> registo(s)</span>
                        </summary>
                        <?php foreach ($items as $index => $record): ?>
                            <div class="table-responsive">
                                <table class="table table-striped dns-record-table">
                                    <thead>
                                        <tr>
                                            <th colspan="2">Registo <?= (int)($index + 1) ?></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    <?php foreach ($record as $key => $value): ?>
                                        <?php
                                        $displayValue = null;
                                        if (is_scalar($value)) {
                                            $displayValue = trim((string)$value);
                                            if ($displayValue === '') {
                                                continue;
                                            }
                                        } elseif (is_array($value) || is_object($value)) {
                                            $jsonValue = json_encode($value, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
                                            if ($jsonValue !== false) {
                                                $displayValue = $jsonValue;
                                            }
                                        }
                                        if ($displayValue === null || $displayValue === '') {
                                            continue;
                                        }
                                        $fieldLabel = ucwords(str_replace(['-', '_'], ' ', (string)$key));
                                        ?>
                                        <tr>
                                            <th scope="row"><?= $e($fieldLabel) ?></th>
                                            <td>
                                                <div class="dns-value-cell">
                                                    <code><?= $e($displayValue) ?></code>
                                                    <button type="button" class="btn btn-default btn-xs dns-copy-button" data-copy="<?= $e($displayValue) ?>">Copiar valor</button>
                                                </div>
                                            </td>
                                        </tr>
                                    <?php endforeach; ?>
                                    </tbody>
                                </table>
                            </div>
                        <?php endforeach; ?>
                    </details>
                <?php endforeach; ?>
            <?php endif; ?>

            <div class="alert alert-info dns-help-note"><?= $e($this->_('LogicboxesEmail.dns.provider_note', true)) ?></div>
        </div>
    </section>

    <span class="dns-copy-status" aria-live="polite"></span>
</div>

<script>
(function () {
    var root = document.querySelector('.logicboxes-email-dns-setup');
    if (!root || root.getAttribute('data-copy-ready') === '1') {
        return;
    }
    root.setAttribute('data-copy-ready', '1');

    function fallbackCopy(value) {
        var field = document.createElement('textarea');
        field.value = value;
        field.setAttribute('readonly', 'readonly');
        field.style.position = 'fixed';
        field.style.left = '-9999px';
        document.body.appendChild(field);
        field.select();
        var copied = false;
        try {
            copied = document.execCommand('copy');
        } catch (error) {
            copied = false;
        }
        document.body.removeChild(field);
        return copied;
    }

    function showResult(button, success) {
        var original = button.getAttribute('data-copy-label') || 'Copiar';
        var status = root.querySelector('.dns-copy-status');
        button.textContent = success ? 'Copiado!' : original;
        if (status) {
            status.textContent = success ? 'Copiado para a área de transferência.' : 'Não foi possível copiar automaticamente. Seleciona o valor e copia manualmente.';
        }
        if (success) {
            window.setTimeout(function () {
                button.textContent = original;
            }, 1800);
        }
    }

    root.querySelectorAll('.dns-copy-button').forEach(function (button) {
        button.setAttribute('data-copy-label', button.textContent.trim());
    });

    root.addEventListener('click', function (event) {
        var button = event.target.closest('.dns-copy-button[data-copy]');
        if (!button || !root.contains(button)) {
            return;
        }
        var value = button.getAttribute('data-copy') || '';
        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(value).then(function () {
                showResult(button, true);
            }).catch(function () {
                showResult(button, fallbackCopy(value));
            });
        } else {
            showResult(button, fallbackCopy(value));
        }
    });
})();
</script>
